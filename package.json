{
  "name": "calendar-tasks",
  "version": "0.2.2",
  "private": true,
  "description": "CalDAV calendar and tasks in Obsidian: a note for every event and task, a calendar view, a Bases task list.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:mobile": "node scripts/check-mobile-load.cjs main.js",
    "ui:preview": "node tools/preview/shoot.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "author": "Abdallah Hammad",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@electron/asar": "^3.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "lucide": "^0.460.0",
    "marked": "^14.1.4",
    "obsidian": "^1.14.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  }
}
